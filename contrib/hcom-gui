    def _screen_bar(self, config):
        """The Screen bar buttons in gui.json "screen_bar" order: a built-in label or {"label", "keys"}."""
        builtin = {b["label"]: b for b in BUTTONS if b != "---" and b.get("bar") == "screen"}
        if "screen_bar" not in config:
            return list(builtin.values())
        items = config["screen_bar"]
        if not isinstance(items, list):
            self.after(0, self.write_log, f"ERROR: {CONFIG_FILE}: screen_bar: not a list, using the default bar")
            return list(builtin.values())
        bar = []
        for item in items:
            if isinstance(item, str) and item in builtin:
                b = builtin[item]
            elif (isinstance(item, dict) and set(item) == {"label", "keys"}
                  and all(isinstance(v, str) and v for v in item.values())):
                b = {"label": item["label"], "cmd": ["hcom", "term", "inject", "{instance}", item["keys"]],
                     "when": "running", "bar": "screen"}
            else:
                self.after(0, self.write_log, f"ERROR: {CONFIG_FILE}: screen_bar: skipped {json.dumps(item)}")
                continue
            if b["label"] in {x["label"] for x in bar}:
                self.after(0, self.write_log, f"ERROR: {CONFIG_FILE}: screen_bar: duplicate {b['label']} skipped")
                continue
            bar.append(b)
        return bar

