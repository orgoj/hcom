            else:
                self.after(0, self.write_log, f"ERROR: {CONFIG_FILE}: attach.{terminal}: not a command list")
        self.buttons = [{**b, "cmds": attach} if b != "---" and b.get("attach") else b for b in BUTTONS]
        self.buttons += [{**b, "when": "dir", "detach": True} for b in open_with]
        if commands := config.get("commands"):
            self.buttons += ["---"] + [{**b, "when": "always"} for b in commands]
        self.buttons = [b for b in self.buttons if b == "---" or not b.get("bar")] + self._screen_bar(config)
        self.toolbar_breaks = config.get("toolbar_breaks") or []
        if not isinstance(self.toolbar_breaks, list):
            self.after(0, self.write_log, f"ERROR: {CONFIG_FILE}: toolbar_breaks: not a list of button labels")
            self.toolbar_breaks = []
        labels = {b["label"] for b in self.buttons if b != "---" and not b.get("bar")} | {"Columns", "Refresh"}
        if unknown := [str(x) for x in self.toolbar_breaks if x not in labels]:
