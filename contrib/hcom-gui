def ts_epoch(ts):
    """Event timestamps are UTC without an offset."""
    return int(datetime.datetime.fromisoformat(ts).replace(tzinfo=datetime.timezone.utc).timestamp())


def event_stats(life, messages, running, now):
    """Usage per instance name. A session runs from its created event to the next stopped
    one; one still open counts up to now while the instance is running."""
    stats, opened = {}, {}

    def of(name):
        return stats.setdefault(name, {"starts": 0, "runtime": 0, "handoffs": 0, "sent": 0, "received": 0,
                                       "last_start": "", "stops": 0, "stop_kinds": [0, 0, 0], "failed": 0})

    for e in sorted(life, key=lambda e: e["id"]):
        data, name = e.get("data") or {}, e["instance"]
        action = data.get("action")
        if action == "created":
            st, t = of(name), ts_epoch(e["ts"])
            st["starts"] += 1
            st["last_start"] = opened[name] = t
        elif action == "stopped":
            st = of(name)
            st["stops"] += 1
            # Idle autokill stops with reason "killed" by "idle_kill"; older events used reason "idle".
            reason = data.get("reason") or ""
            idle = data.get("by") == "idle_kill" or reason == "idle"
            st["stop_kinds"][1 if idle else 0 if reason == "killed" else 2] += 1
            if name in opened:
                st["runtime"] += ts_epoch(e["ts"]) - opened.pop(name)
        elif action == "handoff":
            of(name)["handoffs"] += 1
        elif action in ("launch_failed", "launch_blocked"):
            of(name)["failed"] += 1
    for name, t in opened.items():
        if name in running:
            stats[name]["runtime"] += max(0, now - t)
    for m in messages:
        data = m.get("data") or {}
        of(data.get("from") or m["instance"])["sent"] += 1
        for name in data.get("delivered_to") or []:
            of(name)["received"] += 1
    for st in stats.values():
        st["msgs"] = st["sent"] + st["received"]
    return stats


def add_stats(rows, events):
    """Fill the usage columns from cached events: an instance row by its name, a catalog
    row by its agent name. Rows without events keep empty cells."""
    stats = event_stats(*events, {r["instance"] for r in rows if r["instance"]}, int(time.time())) \
        if events else {}
    for r in rows:
        st = stats.get(r["instance"] or r["agent"])
        r.update(st or dict.fromkeys(STATS, ""))
    return rows


def idle_check(names):
    """{name: class or None} of the listening agents among names, from idle_check.py, or an error
    text: its own stderr category line only, never other output (message text stays private)."""
    try:
        proc = subprocess.Popen([sys.executable, "-I", IDLE_CHECK, "--json", "--", *names], cwd=HOME, env=HCOM_ENV,
                                start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True)
    except OSError as e:
        return f"idle: {e.strerror or type(e).__name__}"
    try:
        out, err = proc.communicate(timeout=IDLE_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        try:  # its own session: the scorer child goes too and frees its VRAM
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        proc.communicate()
        return f"idle: timeout after {IDLE_TIMEOUT_SECONDS} s"
    if proc.returncode != 0:
        lines = [line for line in err.splitlines() if line.startswith("idle_check: ")]
        return f"idle: {lines[-1][len('idle_check: '):]}" if lines else f"idle: exit {proc.returncode}"
    try:
        rows = json.loads(out)
        return {r["name"]: {"class": r["class"] if r["class"] in IDLE_CLASSES else None,
                            "text_sha1": r.get("text_sha1") if isinstance(r.get("text_sha1"), str) else None,
                            "corrected": r.get("corrected") is True} for r in rows}
    except (ValueError, TypeError, KeyError, AttributeError):
        return "idle: output invalid"


def idle_label(sha, cls):
    """Record the user's class of a classified text (idle_check.py --label): None, or an error text."""
    try:
        proc = subprocess.run([sys.executable, "-I", IDLE_CHECK, "--label", sha, cls], cwd=HOME, env=HCOM_ENV,
                              stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"idle label: {getattr(e, 'strerror', None) or type(e).__name__}"
    if proc.returncode != 0:
        lines = [line for line in proc.stderr.splitlines() if line.startswith("idle_check: ")]
        return f"idle label: {lines[-1][len('idle_check: '):]}" if lines else f"idle label: exit {proc.returncode}"
    return None


def idle_periods(periods, rows, now):
    """The listening period of each listening instance row, kept from periods while it goes on:
    {name: {"start", "fallback", "value"}}. Remote instances always report status age 0: there
    the period counts from the first refresh that saw it listening ("fallback")."""
    current = {}
    for r in rows:
        name = r["instance"]
        if not name or r["state"] != "listening":
            continue
        p = periods.get(name)
        if r["since"] > 0:
            start = now - r["since"]
            if p and (abs(start - p["start"]) <= IDLE_START_TOLERANCE if p["fallback"]
                      else start <= p["start"] + IDLE_START_TOLERANCE):
                if p["fallback"]:  # a local agent first seen at age 0: its real start from now on
                    p["start"], p["fallback"] = start, False
            else:
                p = {"start": start, "fallback": False, "value": None}
        elif not p or not p["fallback"]:  # none yet, or a local agent that re-entered listening
            p = {"start": now, "fallback": True, "value": None}
        current[name] = p
    return current


def where(lc):
    """Terminal of an instance's launch_context, with the Herdr workspace/tab: "herdr: ws/tab"."""
    terminal = lc.get("terminal_preset_effective") or ""
    place = "/".join(lc[k] for k in ("herdr_workspace", "herdr_tab") if lc.get(k))
    return f"{terminal}: {place}" if terminal and place else terminal


def status_column_names(catalog):
    """Configured status column names in config order, from hcom agent list --status."""
    return next((d["status_columns"].get("columns") or [] for d in catalog if d.get("status_columns")), [])


def status_values(d, instance):
    """[{name, value, updated_at}] with a value of the instance, or for a row without one, of the
    agent's most recently updated instance."""
    sc = (d or {}).get("status_columns") or {}
    key = instance or sc.get("latest") or ""
    return [v for v in (sc.get("instances") or {}).get(key, []) if v.get("value") is not None]


def with_status(row, names, values):
    """Every status:<name> key (the value on one line, or empty) and "report" (the full values)."""
    by_name = {v["name"]: v["value"] for v in values}
    for name in names:
        row[STATUS_PREFIX + name] = " ".join(str(by_name.get(name, "")).split())
    row["report"] = values
    return row


def report_keys(shown, all_keys, report):
    """Column keys of the Report tab: with report (gui.json) exactly those (known ones) in its
    order; without it the shown columns in table order, then the rest in default order."""
    if report is not None:
        return [k for k in report if k in all_keys]
    return list(dict.fromkeys([*shown, *all_keys]))


def build_rows(catalog, live):
    defs = {d["name"]: d for d in catalog}
    status_names = status_column_names(catalog)
    rows = []
    running = {}  # catalog name -> its running instance names
    for i in live:
        lc = i.get("launch_context") or {}
        d = defs.get(lc.get("agent_name") or "")
        if d:
            running.setdefault(d["name"], []).append(i["name"])
        rows.append(with_status({
            "agent": d["name"] if d else "",
            "instance": i["name"],
            "roaming": "↻" if d and d.get("roaming") else "",
            "cli": i.get("tool") or "",
            "catalog_cli": (d or {}).get("cli") or "",
            "catalog_model": (d or {}).get("model") or "",
            "catalog_reasoning": (d or {}).get("reasoning") or "",
            "groups": (d or {}).get("groups") or [],
            "status": i.get("status", ""),
            "state": i.get("status", ""),
            "since": int(i.get("status_age_seconds") or 0),
            "age": int(time.time() - i["created_at"]) if i.get("created_at") else "",
            "transcript": i.get("transcript_path") or "",
            "where": where(lc),
            "terminal": lc.get("terminal_preset_effective") or "",
            "launch_context": {k: v for k, v in lc.items() if isinstance(v, str)},
            "detail": i.get("status_detail") or "",
            "unread": i.get("unread_count") or "",
            "dir": i.get("directory") or (d or {}).get("dir") or "",
            "config": catalog_label(d["source"]) if d else "",
            # A roaming agent resolves its project from the cwd: run in the instance's directory.
            "cwd": (i.get("directory") if d and d.get("roaming") else None)
                   or (catalog_cwd(d["source"]) if d else HOME),
            "disabled": False,  # a running instance is shown even when its agent is disabled
        }, status_names, status_values(d, i["name"])))
    for d in catalog:
        names = running.get(d["name"], [])
        # A roaming agent's row is the archetype for other projects: never merged into an instance.
        if d["name"] in names and not d.get("roaming"):
            continue
        rows.append(with_status({
            "agent": d["name"],
            "instance": "",
            "roaming": "↻" if d.get("roaming") else "",
            "cli": d.get("cli") or "",
            "catalog_cli": d.get("cli") or "",
            "catalog_model": d.get("model") or "",
            "catalog_reasoning": d.get("reasoning") or "",
            "groups": d.get("groups") or [],
            "status": f"running as {', '.join(names)}" if names else "",
            "state": "",
            "since": "",
            "age": "",
            "transcript": "",
            "where": "",
            "terminal": "",
            "launch_context": {},
            "detail": "",
            "unread": "",
            "dir": d.get("dir") or "",
            "config": catalog_label(d["source"]),
            "cwd": catalog_cwd(d["source"]),
            "disabled": bool(d.get("disabled")),
        }, status_names, status_values(d, "")))
    return rows


def running_groups(rows):
    """Catalog group -> sorted names of its running instances."""
    groups = {}
    for r in rows:
        if r["instance"]:
            for g in r["groups"]:
                groups.setdefault(g, []).append(r["instance"])
    return {g: sorted(names) for g, names in sorted(groups.items())}


def running_tools(rows):
    """CLI tool -> sorted names of its running instances."""
    tools = {}
    for r in rows:
        if r["instance"] and r["cli"]:
            tools.setdefault(r["cli"], []).append(r["instance"])
    return {t: sorted(names) for t, names in sorted(tools.items())}


def all_columns(status_names):
    """COLUMNS followed by one status column per configured name."""
    return COLUMNS + [(STATUS_PREFIX + n, n, STATUS_WIDTH) for n in status_names]


def pick_columns(keys):
    """Known column keys of keys in order without duplicates, and the unknown ones. Status
    column keys stay: their names arrive only with the first refresh (reconcile_status_keys)."""
    known = {c[0] for c in COLUMNS}
    keys = list(dict.fromkeys(keys or []))
    ok = [k for k in keys if k in known or (isinstance(k, str) and k.startswith(STATUS_PREFIX))]
    return ok, [k for k in keys if k not in ok]


def reconcile_status_keys(keys, status_names):
    """keys without the status column keys that status_names does not configure."""
    configured = {STATUS_PREFIX + n for n in status_names}
    return [k for k in keys if not k.startswith(STATUS_PREFIX) or k in configured]


# Column keys of a gui-state.json "columns" choice saved without "columns_known" (before Idle).
LEGACY_KNOWN_COLUMNS = frozenset((
    "agent", "instance", "cli", "status", "since", "age", "context", "quota", "detail", "unread",
    "dir", "branch", "git", "where", "config", "starts", "runtime", "handoffs", "msgs",
    "last_start", "stops", "failed",
))


def with_new_columns(keys, known):
    """keys plus every COLUMNS key that known (the keys when the choice was saved; without it,
    LEGACY_KNOWN_COLUMNS) lacks, after its nearest preceding COLUMNS key in keys."""
    if not keys:
        return keys
    known = {k for k in known if isinstance(k, str)} if isinstance(known, list) else LEGACY_KNOWN_COLUMNS
    order = [c[0] for c in COLUMNS]
    out = list(keys)
    for i, key in enumerate(order):
        if key not in known and key not in out:
            prev = next((k for k in reversed(order[:i]) if k in out), None)
            out.insert(out.index(prev) + 1 if prev else 0, key)
    return out


def column_specs(keys, status_names=()):
    """Column entries for keys in their order (status keys not configured yet are left out);
    all columns when none is left."""
    columns = all_columns(status_names)
    specs = {c[0]: c for c in columns}
    return [specs[k] for k in keys if k in specs] or columns


def enabled(button, row):
    if button["when"] == "always":
        return True
    if row is None:
        return False
    if path := button.get("if_exists"):
        if not row["dir"] or not os.path.exists(path.format(dir=os.path.expanduser(row["dir"]))):
            return False
    return {
        "catalog": bool(row["agent"]),
        "running": bool(row["instance"]),
        "live": bool(row["agent"]) and bool(row["instance"]),
        "stopped": bool(row["agent"]) and not row["instance"],
        "dir": bool(row["dir"]),
    }[button["when"]]


