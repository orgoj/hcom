def tilde(path):
    if path and (path == HOME or path.startswith(HOME + "/")):
        return "~" + path[len(HOME):]
    return path or ""


def age(seconds):
    s = int(seconds or 0)
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= size:
            return f"{s // size}{unit}"
    return f"{s}s"


def cell(col, row):
    """Display text of a row value; rows keep ages in seconds, context in tokens and quota
    in percent so they sort numerically."""
    value = row[col]
    if col == "dir":
        return tilde(value)
    if col == "idle" and row.get("idle_corrected"):
        return f"{value} ✓"
    if col in ("since", "age") and value != "":
        return age(value)
    if col == "context" and value != "":
        return f"{round(value / 1000)}k {round(100 * value / row['context_window'])}%"
    if col == "quota" and value != "":
        return f"{round(value)}%"
    if col == "runtime" and value != "":
        return age(value)
    if col == "msgs" and value != "":
        return f"{row['sent']}/{row['received']}"
    if col == "last_start" and value != "":
        return time.strftime("%m-%d %H:%M", time.localtime(value))
    if col == "stops" and value != "":
        killed, idle, other = row["stop_kinds"]
        return f"{value}: {killed}k {idle}i {other}e"
    return value


def key_label(sequence):
    """Short text of a Tk event sequence for a button label: "<Control-F2>" -> "Ctrl+F2"."""
    text = sequence.strip("<>")
    for tk_name, short in (("Delete", "Del"), ("Control-", "Ctrl+"), ("Shift-", "Shift+"), ("Alt-", "Alt+")):
        text = text.replace(tk_name, short)
    return text


def catalog_files(source):
    """The agents.json files defining an agent, from `agent list --json` "source"
    ("global", "import:<path>", or several joined by "+"; the last one wins)."""
    files = []
    for label in source.split("+"):
        if label == "global":
            files.append(os.path.join(HCOM_DIR, "agents.json"))
        else:
            files.append(label[len("import:"):] if label.startswith("import:") else label)
    return files


def catalog_cwd(source):
    """Where a project agent is addressable: the directory holding its .hcom."""
    path = catalog_files(source)[-1]
    if os.path.basename(os.path.dirname(path)) == ".hcom":
        return os.path.dirname(os.path.dirname(path))
    return HOME


def catalog_label(source):
    return " + ".join(tilde(f) for f in catalog_files(source))


def hcom_json(*args):
    out = subprocess.run(["hcom", *args], cwd=HOME, env=HCOM_ENV, capture_output=True, text=True, timeout=30)
    if out.returncode != 0:
        raise RuntimeError(f"hcom {' '.join(args)}: {out.stderr.strip() or out.returncode}")
    return json.loads(out.stdout or "[]")


def git_state(path):
    """(branch, state) of the worktree at path, e.g. ("main", "* ↑2 ↓1"): * uncommitted
    changes, ↑/↓ commits ahead of/behind the upstream. ("", "") outside a git repo."""
    try:
        # --no-optional-locks: never take index.lock away from an agent's own git command.
        out = subprocess.run(["git", "--no-optional-locks", "-C", path, "status", "--porcelain=v2", "--branch"],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return "", ""
    if out.returncode != 0:
        return "", ""
    branch, dirty, ahead, behind = "", False, 0, 0
    for line in out.stdout.splitlines():
        if line.startswith("# branch.head "):
            branch = line.split(" ", 2)[2]
        elif line.startswith("# branch.ab "):  # "# branch.ab +2 -1", only with an upstream
            ahead, behind = (abs(int(n)) for n in line.split()[2:4])
        elif not line.startswith("#"):
            dirty = True
    state = ("*" if dirty else "", f"↑{ahead}" if ahead else "", f"↓{behind}" if behind else "")
    return branch, " ".join(s for s in state if s)


def add_git(rows):
    """Fill each row's branch and git columns; one git call per distinct directory."""
    states = {}
    for r in rows:
        d = os.path.expanduser(r["dir"]) if r["dir"] else ""
        if d not in states:
            states[d] = git_state(d) if d else ("", "")
        r["branch"], r["git"] = states[d]
    return rows


# Claude transcripts do not record the context window; current Claude Code models run with 1M.
CLAUDE_CONTEXT_WINDOW = 1_000_000
TRANSCRIPT_TAIL_BYTES = 1 << 20
_usage_cache = {}  # transcript path -> ((mtime_ns, size), usage)


def transcript_usage(tool, path):
    """Usage read from the tail of a Claude or Codex transcript: "context" (tokens, window)
    of the latest model call and, for Codex, "quota" (used percent of the primary rate
    limit). Unknown values are missing."""
    try:
        st = os.stat(path)
        key = (st.st_mtime_ns, st.st_size)
        if path in _usage_cache and _usage_cache[path][0] == key:
            return _usage_cache[path][1]
        with open(path, "rb") as f:
            f.seek(max(0, st.st_size - TRANSCRIPT_TAIL_BYTES))
            lines = f.read().splitlines()
    except OSError:
        return {}
    usage = {}
    marker = {"claude": b'"usage"', "codex": b'"token_count"'}.get(tool)
    for line in reversed(lines) if marker else ():
        if marker not in line:
            continue
        try:
            e = json.loads(line)
        except ValueError:  # the cut first line of the tail
            continue
        if tool == "claude":
            if e.get("type") != "assistant" or e.get("isSidechain"):
                continue
            u = (e.get("message") or {}).get("usage") or {}
            tokens = sum(u.get(k) or 0 for k in
                         ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
            if tokens:
                usage["context"] = (tokens, max(CLAUDE_CONTEXT_WINDOW, tokens))
                break
        else:
            payload = e.get("payload") or {}
            info = payload.get("info") or {}
            tokens = (info.get("last_token_usage") or {}).get("input_tokens") or 0
            window = info.get("model_context_window") or 0
            if tokens and window:
                usage.setdefault("context", (tokens, window))
            percent = ((payload.get("rate_limits") or {}).get("primary") or {}).get("used_percent")
            if percent is not None:
                usage.setdefault("quota", percent)
            if len(usage) == 2:
                break
    _usage_cache[path] = (key, usage)
    return usage


def add_usage(rows):
    """Fill each row's context and quota columns from its transcript."""
    for r in rows:
        usage = transcript_usage(r["cli"], r["transcript"]) if r["transcript"] else {}
        r["context"], r["context_window"] = usage.get("context", ("", 0))
        r["quota"] = usage.get("quota", "")
    return rows


def hcom_jsonl(*args):
    out = subprocess.run(["hcom", *args], cwd=HOME, env=HCOM_ENV, capture_output=True, text=True, timeout=60)
    if out.returncode != 0:
        raise RuntimeError(f"hcom {' '.join(args)}: {out.stderr.strip() or out.returncode}")
    return [json.loads(line) for line in out.stdout.splitlines() if line.strip()]


def load_events():
    """Every life and message event of the live database (messages with their recipients)."""
    return (hcom_jsonl("events", "--type", "life", "--last", "100000000"),
            hcom_jsonl("events", "--type", "message", "--full", "--last", "100000000"))


def ts_epoch(ts):
    """Event timestamps are UTC without an offset."""
    return int(datetime.datetime.fromisoformat(ts).replace(tzinfo=datetime.timezone.utc).timestamp())


def event_stats(life, messages, running, now):
    """Usage per instance name. A session runs from its created event to the next stopped
    one; one still open counts up to now while the instance is running."""
    stats, opened = {}, {}

    def of(name):
        return stats.setdefault(name, {"starts": 0, "runtime": 0, "handoffs": 0, "sent": 0, "received": 0,
                                       "last_start": "", "stops": 0, "stop_kinds": [0, 0, 0], "failed": 0})

    for e in sorted(life, key=lambda e: e["id"]):
        data, name = e.get("data") or {}, e["instance"]
        action = data.get("action")
        if action == "created":
            st, t = of(name), ts_epoch(e["ts"])
            st["starts"] += 1
            st["last_start"] = opened[name] = t
        elif action == "stopped":
            st = of(name)
            st["stops"] += 1
            # Idle autokill stops with reason "killed" by "idle_kill"; older events used reason "idle".
            reason = data.get("reason") or ""
            idle = data.get("by") == "idle_kill" or reason == "idle"
            st["stop_kinds"][1 if idle else 0 if reason == "killed" else 2] += 1
            if name in opened:
                st["runtime"] += ts_epoch(e["ts"]) - opened.pop(name)
        elif action == "handoff":
            of(name)["handoffs"] += 1
        elif action in ("launch_failed", "launch_blocked"):
            of(name)["failed"] += 1
    for name, t in opened.items():
        if name in running:
            stats[name]["runtime"] += max(0, now - t)
    for m in messages:
        data = m.get("data") or {}
        of(data.get("from") or m["instance"])["sent"] += 1
        for name in data.get("delivered_to") or []:
            of(name)["received"] += 1
    for st in stats.values():
        st["msgs"] = st["sent"] + st["received"]
    return stats


def add_stats(rows, events):
    """Fill the usage columns from cached events: an instance row by its name, a catalog
    row by its agent name. Rows without events keep empty cells."""
    stats = event_stats(*events, {r["instance"] for r in rows if r["instance"]}, int(time.time())) \
        if events else {}
    for r in rows:
        st = stats.get(r["instance"] or r["agent"])
        r.update(st or dict.fromkeys(STATS, ""))
    return rows


def idle_check(names):
    """{name: class or None} of the listening agents among names, from idle_check.py, or an error
    text: its own stderr category line only, never other output (message text stays private)."""
    try:
        proc = subprocess.Popen([sys.executable, "-I", IDLE_CHECK, "--json", "--", *names], cwd=HOME, env=HCOM_ENV,
                                start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True)
    except OSError as e:
        return f"idle: {e.strerror or type(e).__name__}"
    try:
        out, err = proc.communicate(timeout=IDLE_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        try:  # its own session: the scorer child goes too and frees its VRAM
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        proc.communicate()
        return f"idle: timeout after {IDLE_TIMEOUT_SECONDS} s"
    if proc.returncode != 0:
        lines = [line for line in err.splitlines() if line.startswith("idle_check: ")]
        return f"idle: {lines[-1][len('idle_check: '):]}" if lines else f"idle: exit {proc.returncode}"
    try:
        rows = json.loads(out)
        return {r["name"]: {"class": r["class"] if r["class"] in IDLE_CLASSES else None,
                            "text_sha1": r.get("text_sha1") if isinstance(r.get("text_sha1"), str) else None,
                            "corrected": r.get("corrected") is True} for r in rows}
    except (ValueError, TypeError, KeyError, AttributeError):
        return "idle: output invalid"


def idle_label(sha, cls):
    """Record the user's class of a classified text (idle_check.py --label): None, or an error text."""
    try:
        proc = subprocess.run([sys.executable, "-I", IDLE_CHECK, "--label", sha, cls], cwd=HOME, env=HCOM_ENV,
                              stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"idle label: {getattr(e, 'strerror', None) or type(e).__name__}"
    if proc.returncode != 0:
        lines = [line for line in proc.stderr.splitlines() if line.startswith("idle_check: ")]
        return f"idle label: {lines[-1][len('idle_check: '):]}" if lines else f"idle label: exit {proc.returncode}"
    return None


def idle_periods(periods, rows, now):
    """The listening period of each listening instance row, kept from periods while it goes on:
    {name: {"start", "fallback", "value"}}. Remote instances always report status age 0: there
    the period counts from the first refresh that saw it listening ("fallback")."""
    current = {}
    for r in rows:
        name = r["instance"]
        if not name or r["state"] != "listening":
            continue
        p = periods.get(name)
        if r["since"] > 0:
            start = now - r["since"]
            if p and (abs(start - p["start"]) <= IDLE_START_TOLERANCE if p["fallback"]
                      else start <= p["start"] + IDLE_START_TOLERANCE):
                if p["fallback"]:  # a local agent first seen at age 0: its real start from now on
                    p["start"], p["fallback"] = start, False
            else:
                p = {"start": start, "fallback": False, "value": None}
        elif not p or not p["fallback"]:  # none yet, or a local agent that re-entered listening
            p = {"start": now, "fallback": True, "value": None}
        current[name] = p
    return current


def where(lc):
    """Terminal of an instance's launch_context, with the Herdr workspace/tab: "herdr: ws/tab"."""
    terminal = lc.get("terminal_preset_effective") or ""
    place = "/".join(lc[k] for k in ("herdr_workspace", "herdr_tab") if lc.get(k))
    return f"{terminal}: {place}" if terminal and place else terminal


def build_rows(catalog, live):
    defs = {d["name"]: d for d in catalog}
    rows = []
    running = {}  # catalog name -> its running instance names
    for i in live:
        lc = i.get("launch_context") or {}
        d = defs.get(lc.get("agent_name") or "")
        if d:
            running.setdefault(d["name"], []).append(i["name"])
        rows.append({
            "agent": d["name"] if d else "",
            "instance": i["name"],
            "cli": i.get("tool") or "",
            "catalog_cli": (d or {}).get("cli") or "",
            "groups": (d or {}).get("groups") or [],
            "status": i.get("status", ""),
            "state": i.get("status", ""),
            "since": int(i.get("status_age_seconds") or 0),
            "age": int(time.time() - i["created_at"]) if i.get("created_at") else "",
            "transcript": i.get("transcript_path") or "",
            "where": where(lc),
            "terminal": lc.get("terminal_preset_effective") or "",
            "launch_context": {k: v for k, v in lc.items() if isinstance(v, str)},
            "detail": i.get("status_detail") or "",
            "unread": i.get("unread_count") or "",
            "dir": i.get("directory") or (d or {}).get("dir") or "",
            "config": catalog_label(d["source"]) if d else "",
            # A roaming agent resolves its project from the cwd: run in the instance's directory.
            "cwd": (i.get("directory") if d and d.get("roaming") else None)
                   or (catalog_cwd(d["source"]) if d else HOME),
            "disabled": False,  # a running instance is shown even when its agent is disabled
        })
    for d in catalog:
        names = running.get(d["name"], [])
        if d["name"] in names:
            continue
        rows.append({
            "agent": d["name"],
            "instance": "",
            "cli": d.get("cli") or "",
            "catalog_cli": d.get("cli") or "",
            "groups": d.get("groups") or [],
            "status": f"running as {', '.join(names)}" if names else "",
            "state": "",
            "since": "",
            "age": "",
            "transcript": "",
            "where": "",
            "terminal": "",
            "launch_context": {},
            "detail": "",
            "unread": "",
            "dir": d.get("dir") or "",
            "config": catalog_label(d["source"]),
            "cwd": catalog_cwd(d["source"]),
            "disabled": bool(d.get("disabled")),
        })
    return rows


def running_groups(rows):
    """Catalog group -> sorted names of its running instances."""
    groups = {}
    for r in rows:
        if r["instance"]:
            for g in r["groups"]:
                groups.setdefault(g, []).append(r["instance"])
    return {g: sorted(names) for g, names in sorted(groups.items())}


def running_tools(rows):
    """CLI tool -> sorted names of its running instances."""
    tools = {}
    for r in rows:
        if r["instance"] and r["cli"]:
            tools.setdefault(r["cli"], []).append(r["instance"])
    return {t: sorted(names) for t, names in sorted(tools.items())}


def pick_columns(keys):
    """Known column keys of keys in order without duplicates, and the unknown ones."""
    known = {c[0] for c in COLUMNS}
    keys = list(dict.fromkeys(keys or []))
    return [k for k in keys if k in known], [k for k in keys if k not in known]


