def format_events(stdout):
    """`hcom events` JSON lines -> one "HH:MM:SS type detail" line per event (local time)."""
    lines = []
    for line in stdout.splitlines():
        if not line.strip():
            continue
        try:
            e = json.loads(line)
            d = e.get("data") or {}
            kind = e.get("type", "")
            if kind == "status":
                detail = f"{d.get('status', '')} {d.get('context', '')}: {d.get('detail', '')}"
            elif kind == "message":
                detail = f"{d.get('from', '')}: {d.get('text', '')}"
            elif kind == "life":
                detail = d.get("action", "") + (f" by {d['by']}" if d.get("by") else "")
            else:
                detail = json.dumps(d, ensure_ascii=False)
            when = datetime.datetime.fromtimestamp(ts_epoch(e["ts"])).strftime("%H:%M:%S")
            lines.append(" ".join(f"{when} {kind} {detail}".split()))
        except (ValueError, KeyError, TypeError, AttributeError):
            lines.append(line)
    return "\n".join(lines)


