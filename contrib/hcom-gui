# A detached program that exits non-zero within this time gets its exit code and stderr logged.
DETACH_WATCH_SECONDS = 5

# Run hcom as the human, not as the agent whose terminal started the GUI.
HCOM_ENV = {k: v for k, v in os.environ.items() if not k.startswith("HCOM_")}


def tilde(path):
    if path and (path == HOME or path.startswith(HOME + "/")):
        return "~" + path[len(HOME):]
    return path or ""


def age(seconds):
    s = int(seconds or 0)
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= size:
            return f"{s // size}{unit}"
    return f"{s}s"


def cell(col, row):
    """Display text of a row value; rows keep ages in seconds, context in tokens and quota
    in percent so they sort numerically."""
    value = row[col]
    if col == "dir":
        return tilde(value)
    if col in ("since", "age") and value != "":
        return age(value)
    if col == "context" and value != "":
        return f"{round(value / 1000)}k {round(100 * value / row['context_window'])}%"
    if col == "quota" and value != "":
        return f"{round(value)}%"
    return value


def key_label(sequence):
    """Short text of a Tk event sequence for a button label: "<Control-F2>" -> "Ctrl+F2"."""
    text = sequence.strip("<>")
    for tk_name, short in (("Delete", "Del"), ("Control-", "Ctrl+"), ("Shift-", "Shift+"), ("Alt-", "Alt+")):
        text = text.replace(tk_name, short)
    return text


def catalog_files(source):
    """The agents.json files defining an agent, from `agent list --json` "source"
    ("global", "import:<path>", or several joined by "+"; the last one wins)."""
    files = []
    for label in source.split("+"):
        if label == "global":
            files.append(os.path.join(HCOM_DIR, "agents.json"))
        else:
            files.append(label[len("import:"):] if label.startswith("import:") else label)
    return files


def catalog_cwd(source):
    """Where a project agent is addressable: the directory holding its .hcom."""
    path = catalog_files(source)[-1]
    if os.path.basename(os.path.dirname(path)) == ".hcom":
        return os.path.dirname(os.path.dirname(path))
    return HOME


def catalog_label(source):
    return " + ".join(tilde(f) for f in catalog_files(source))


def hcom_json(*args):
    out = subprocess.run(["hcom", *args], cwd=HOME, env=HCOM_ENV, capture_output=True, text=True, timeout=30)
    if out.returncode != 0:
        raise RuntimeError(f"hcom {' '.join(args)}: {out.stderr.strip() or out.returncode}")
    return json.loads(out.stdout or "[]")


def git_state(path):
    """(branch, state) of the worktree at path, e.g. ("main", "* ↑2 ↓1"): * uncommitted
    changes, ↑/↓ commits ahead of/behind the upstream. ("", "") outside a git repo."""
    try:
        # --no-optional-locks: never take index.lock away from an agent's own git command.
        out = subprocess.run(["git", "--no-optional-locks", "-C", path, "status", "--porcelain=v2", "--branch"],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return "", ""
    if out.returncode != 0:
        return "", ""
    branch, dirty, ahead, behind = "", False, 0, 0
    for line in out.stdout.splitlines():
        if line.startswith("# branch.head "):
            branch = line.split(" ", 2)[2]
        elif line.startswith("# branch.ab "):  # "# branch.ab +2 -1", only with an upstream
            ahead, behind = (abs(int(n)) for n in line.split()[2:4])
        elif not line.startswith("#"):
            dirty = True
    state = ("*" if dirty else "", f"↑{ahead}" if ahead else "", f"↓{behind}" if behind else "")
    return branch, " ".join(s for s in state if s)


def add_git(rows):
    """Fill each row's branch and git columns; one git call per distinct directory."""
    states = {}
    for r in rows:
        d = os.path.expanduser(r["dir"]) if r["dir"] else ""
        if d not in states:
            states[d] = git_state(d) if d else ("", "")
        r["branch"], r["git"] = states[d]
    return rows


# Claude transcripts do not record the context window; current Claude Code models run with 1M.
CLAUDE_CONTEXT_WINDOW = 1_000_000
TRANSCRIPT_TAIL_BYTES = 1 << 20
_usage_cache = {}  # transcript path -> ((mtime_ns, size), usage)


def transcript_usage(tool, path):
    """Usage read from the tail of a Claude or Codex transcript: "context" (tokens, window)
    of the latest model call and, for Codex, "quota" (used percent of the primary rate
    limit). Unknown values are missing."""
    try:
        st = os.stat(path)
        key = (st.st_mtime_ns, st.st_size)
        if path in _usage_cache and _usage_cache[path][0] == key:
            return _usage_cache[path][1]
        with open(path, "rb") as f:
            f.seek(max(0, st.st_size - TRANSCRIPT_TAIL_BYTES))
            lines = f.read().splitlines()
    except OSError:
        return {}
    usage = {}
    marker = {"claude": b'"usage"', "codex": b'"token_count"'}.get(tool)
    for line in reversed(lines) if marker else ():
        if marker not in line:
            continue
        try:
            e = json.loads(line)
        except ValueError:  # the cut first line of the tail
            continue
        if tool == "claude":
            if e.get("type") != "assistant" or e.get("isSidechain"):
                continue
            u = (e.get("message") or {}).get("usage") or {}
            tokens = sum(u.get(k) or 0 for k in
                         ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
            if tokens:
                usage["context"] = (tokens, max(CLAUDE_CONTEXT_WINDOW, tokens))
                break
        else:
            payload = e.get("payload") or {}
            info = payload.get("info") or {}
            tokens = (info.get("last_token_usage") or {}).get("input_tokens") or 0
            window = info.get("model_context_window") or 0
            if tokens and window:
                usage.setdefault("context", (tokens, window))
            percent = ((payload.get("rate_limits") or {}).get("primary") or {}).get("used_percent")
            if percent is not None:
                usage.setdefault("quota", percent)
            if len(usage) == 2:
                break
    _usage_cache[path] = (key, usage)
    return usage


def add_usage(rows):
    """Fill each row's context and quota columns from its transcript."""
    for r in rows:
        usage = transcript_usage(r["cli"], r["transcript"]) if r["transcript"] else {}
        r["context"], r["context_window"] = usage.get("context", ("", 0))
        r["quota"] = usage.get("quota", "")
    return rows


def where(lc):
    """Terminal of an instance's launch_context, with the Herdr workspace/tab: "herdr: ws/tab"."""
    terminal = lc.get("terminal_preset_effective") or ""
    place = "/".join(lc[k] for k in ("herdr_workspace", "herdr_tab") if lc.get(k))
    return f"{terminal}: {place}" if terminal and place else terminal


def build_rows(catalog, live):
    defs = {d["name"]: d for d in catalog}
    rows = []
    running = {}  # catalog name -> its running instance names
    for i in live:
        lc = i.get("launch_context") or {}
        d = defs.get(lc.get("agent_name") or "")
        if d:
            running.setdefault(d["name"], []).append(i["name"])
        rows.append({
            "agent": d["name"] if d else "",
            "instance": i["name"],
            "cli": i.get("tool") or "",
            "catalog_cli": (d or {}).get("cli") or "",
            "groups": (d or {}).get("groups") or [],
            "status": i.get("status", ""),
            "state": i.get("status", ""),
            "since": int(i.get("status_age_seconds") or 0),
            "age": int(time.time() - i["created_at"]) if i.get("created_at") else "",
            "transcript": i.get("transcript_path") or "",
            "where": where(lc),
            "terminal": lc.get("terminal_preset_effective") or "",
            "launch_context": {k: v for k, v in lc.items() if isinstance(v, str)},
            "detail": i.get("status_detail") or "",
            "unread": i.get("unread_count") or "",
            "dir": i.get("directory") or (d or {}).get("dir") or "",
            "config": catalog_label(d["source"]) if d else "",
            # A roaming agent resolves its project from the cwd: run in the instance's directory.
            "cwd": (i.get("directory") if d and d.get("roaming") else None)
                   or (catalog_cwd(d["source"]) if d else HOME),
        })
    for d in catalog:
        names = running.get(d["name"], [])
        if d["name"] in names:
            continue
        rows.append({
            "agent": d["name"],
            "instance": "",
            "cli": d.get("cli") or "",
            "catalog_cli": d.get("cli") or "",
            "groups": d.get("groups") or [],
            "status": f"running as {', '.join(names)}" if names else "",
            "state": "",
            "since": "",
            "age": "",
            "transcript": "",
            "where": "",
            "terminal": "",
            "launch_context": {},
            "detail": "",
            "unread": "",
            "dir": d.get("dir") or "",
            "config": catalog_label(d["source"]),
            "cwd": catalog_cwd(d["source"]),
        })
    return rows


def running_groups(rows):
    """Catalog group -> sorted names of its running instances."""
    groups = {}
    for r in rows:
        if r["instance"]:
            for g in r["groups"]:
                groups.setdefault(g, []).append(r["instance"])
    return {g: sorted(names) for g, names in sorted(groups.items())}


def running_tools(rows):
    """CLI tool -> sorted names of its running instances."""
    tools = {}
    for r in rows:
        if r["instance"] and r["cli"]:
            tools.setdefault(r["cli"], []).append(r["instance"])
    return {t: sorted(names) for t, names in sorted(tools.items())}


def pick_columns(keys):
    """Known column keys of keys in order without duplicates, and the unknown ones."""
    known = {c[0] for c in COLUMNS}
    keys = list(dict.fromkeys(keys or []))
    return [k for k in keys if k in known], [k for k in keys if k not in known]


def column_specs(keys):
    """COLUMNS entries for keys in their order; all columns when keys is empty."""
    specs = {c[0]: c for c in COLUMNS}
    return [specs[k] for k in keys] or COLUMNS


def enabled(button, row):
    if button["when"] == "always":
        return True
    if row is None:
        return False
    if path := button.get("if_exists"):
        if not row["dir"] or not os.path.exists(path.format(dir=os.path.expanduser(row["dir"]))):
            return False
    return {
        "catalog": bool(row["agent"]),
        "running": bool(row["instance"]),
        "live": bool(row["agent"]) and bool(row["instance"]),
        "stopped": bool(row["agent"]) and not row["instance"],
        "dir": bool(row["dir"]),
    }[button["when"]]


class App(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("hcom-gui")
        default_font = ("DejaVu Sans", 11)
        self.option_add("*Font", default_font)
        style = ttk.Style()
        style.configure(".", font=default_font)
        style.configure("Treeview", font=default_font, rowheight=28)
        style.configure("Treeview.Heading", font=(default_font[0], 11, "bold"))
        style.configure("TButton", font=default_font, padding=5)
        style.map("Treeview", background=[("selected", "#80D4FF")], foreground=[("selected", "#000000")])

        config = self._load_json(CONFIG_FILE)
        self.refresh_ms = int(float(config.get("refresh_seconds", 5)) * 1000)
        open_with = config.get("open_with", DEFAULT_OPEN_WITH)
        attach = {}
        for terminal, cmd in (config.get("attach") or {}).items():
            if isinstance(cmd, list) and cmd and all(isinstance(t, str) for t in cmd):
                attach[terminal] = cmd
            else:
                self.after(0, self.write_log, f"ERROR: {CONFIG_FILE}: attach.{terminal}: not a command list")
        self.buttons = [{**b, "cmds": attach} if b != "---" and b.get("attach") else b for b in BUTTONS]
        self.buttons += [{**b, "when": "dir", "detach": True} for b in open_with]
        if commands := config.get("commands"):
            self.buttons += ["---"] + [{**b, "when": "always"} for b in commands]
        self.config_columns, unknown = pick_columns(config.get("columns"))
        if unknown:
            self.after(0, self.write_log, f"ERROR: {CONFIG_FILE}: unknown columns: {', '.join(unknown)}")
        # Chosen in the Columns dialog; overrides gui.json "columns".
        self.state_columns = pick_columns(self._load_json(STATE_FILE).get("columns"))[0]
        self.columns = column_specs(self.state_columns or self.config_columns)

        self.rows = {}
        self.groups = ({}, {})  # running_groups, running_tools
        self.sort_col, self.sort_reverse = None, False
        self.busy = self.refreshing = self.refresh_again = False
        self.timer = None
        self.last_error = None
        self.last_selected = None
        self.select_next = None  # row id selected once it appears (an instance started with --as)

        self._create_widgets()
        self._restore_state()
        self.protocol("WM_DELETE_WINDOW", self._on_close)
        self.refresh()

    # ── Widgets ────────────────────────────────────────────────────────

    def _create_widgets(self):
        toolbar = ttk.Frame(self)
        toolbar.pack(fill=tk.X, padx=5, pady=5)
        for b in self.buttons:
            if b == "---":
                ttk.Separator(toolbar, orient=tk.VERTICAL).pack(side=tk.LEFT, fill=tk.Y, padx=10)
                continue
            if b.get("menu"):
                b["widget"] = ttk.Menubutton(toolbar, text=f"{b['label']} ▾")
                self.group_menu = tk.Menu(b["widget"], tearoff=False)
                b["widget"]["menu"] = self.group_menu
            else:
                text = f"{b['label']} ({key_label(b['key'])})" if b.get("key") else b["label"]
                b["widget"] = ttk.Button(toolbar, text=text, command=lambda b=b: self.run_button(b))
            b["widget"].pack(side=tk.LEFT, padx=2)
        self.refresh_button = ttk.Button(toolbar, text=f"Refresh ({key_label('<F5>')})", command=self.refresh)
        self.refresh_button.pack(side=tk.RIGHT, padx=2)
        self.columns_button = ttk.Button(toolbar, text="Columns…", command=self.choose_columns)
        self.columns_button.pack(side=tk.RIGHT, padx=2)
        self.running_only = tk.BooleanVar(value=False)
        ttk.Checkbutton(toolbar, text="Running only", variable=self.running_only,
                        command=self.render).pack(side=tk.RIGHT, padx=10)
        self.blocked_only = tk.BooleanVar(value=False)
        ttk.Checkbutton(toolbar, text="Blocked only", variable=self.blocked_only,
                        command=self.render).pack(side=tk.RIGHT, padx=10)
        self.filter_text = tk.StringVar()
        self.filter_text.trace_add("write", lambda *_: self.render())
        self.filter_entry = ttk.Entry(toolbar, textvariable=self.filter_text, width=16)
        self.filter_entry.pack(side=tk.RIGHT, padx=2)
        ttk.Label(toolbar, text="Filter:").pack(side=tk.RIGHT, padx=2)

        self.paned = ttk.PanedWindow(self, orient=tk.VERTICAL)
        self.paned.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)

        frame = ttk.Frame(self.paned)
        self.tree = ttk.Treeview(frame, show="headings", selectmode="browse")
        self._configure_columns({})
        scroll = ttk.Scrollbar(frame, orient=tk.VERTICAL, command=self.tree.yview)
        self.tree.configure(yscrollcommand=scroll.set)
        self.tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scroll.pack(side=tk.RIGHT, fill=tk.Y)
        self.tree.tag_configure("active", foreground="#1a7f37")
        self.tree.tag_configure("blocked", foreground="#d97706", font=("DejaVu Sans", 11, "bold"))
        self.tree.tag_configure("error", foreground="red")
        self.tree.tag_configure("stopped", foreground="#888888")
        self.paned.add(frame, weight=3)

        frame = ttk.Frame(self.paned)
        self.log = tk.Text(frame, height=8, font=("DejaVu Sans Mono", 10), state=tk.DISABLED, wrap=tk.WORD)
        scroll = ttk.Scrollbar(frame, orient=tk.VERTICAL, command=self.log.yview)
        self.log.configure(yscrollcommand=scroll.set)
        self.log.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scroll.pack(side=tk.RIGHT, fill=tk.Y)
        self.paned.add(frame, weight=1)

        self.tree.bind("<<TreeviewSelect>>", self._on_select)
        self.tree.bind("<Double-1>", lambda e: self.run_default())
        self.tree.bind("<Return>", lambda e: self.run_default())
        self.tree.bind("<KP_Enter>", lambda e: self.run_default())
        self.bind("<F5>", lambda e: self.refresh())
        for widget in (self, self.tree):  # tree: before its class binding moves from a stale focus row
            widget.bind("<Up>", lambda e: self._step_row(e, -1))
            widget.bind("<Down>", lambda e: self._step_row(e, 1))
        for b in self.buttons:
            if b != "---" and b.get("key"):
                self.tree.bind(b["key"], lambda e, b=b: self.run_button(b))

    def _step_row(self, event, step):
        """Up/Down outside the table, or in it with no row selected: move the selection and focus the table."""
        items = self.tree.get_children()
        sel = self.tree.selection()
        if not items or (event.widget is self.tree and sel):  # the Treeview moves by itself
            return
        if sel:
            i = max(0, min(len(items) - 1, items.index(sel[0]) + step))
        else:
            i = 0 if step > 0 else len(items) - 1
        self.tree.selection_set(items[i])
        self.tree.focus(items[i])
        self.tree.see(items[i])
        self.tree.focus_set()
        return "break"

    def _configure_columns(self, widths):
        """Show self.columns; widths (key -> width) override the default widths."""
        self.tree["columns"] = [c[0] for c in self.columns]
        for key, title, width in self.columns:
            self.tree.heading(key, text=title, command=lambda k=key: self.sort_by(k))
            self.tree.column(key, width=widths.get(key, width), anchor=tk.W)

    def set_columns(self, keys):
        """Show keys (visible columns in order) and save them; None returns to gui.json/default."""
        widths = {c: self.tree.column(c, "width") for c in self.tree["columns"]}
        self.state_columns = keys
        self.columns = column_specs(keys or self.config_columns)
        self._configure_columns(widths)
        if self.sort_col not in self.tree["columns"]:
            self.sort_col, self.sort_reverse = None, False
        self.render()
        self._save_state()

    def write_log(self, text):
        self.log.configure(state=tk.NORMAL)
        self.log.insert(tk.END, text.rstrip("\n") + "\n")
        self.log.see(tk.END)
        self.log.configure(state=tk.DISABLED)

    def selected(self):
        sel = self.tree.selection()
        return self.rows.get(sel[0]) if sel else None

    def update_buttons(self):
        row = self.selected()
        for b in self.buttons:
            if b != "---":
                ok = any(self.groups) if b.get("menu") else enabled(b, row)
                idle = not self.busy or b.get("detach")
                b["widget"].configure(state=tk.NORMAL if idle and ok else tk.DISABLED)

    def _on_select(self, _event):
        sel = self.tree.selection()
        if sel and sel[0] != self.last_selected:  # render() re-selects on every refresh
            self.select_next = None  # another row chosen: do not jump to a started instance
            row = self.rows[sel[0]]
            if row["detail"]:
                self.write_log(f"{row['instance']}: {row['detail']}")
        self.last_selected = sel[0] if sel else None
        self.update_buttons()

    # ── Refresh ────────────────────────────────────────────────────────

    def refresh(self):
        if self.refreshing:
            self.refresh_again = True
            return
        if self.timer:
            self.after_cancel(self.timer)
            self.timer = None
        self.refreshing = True

        def work():
            try:
                result = add_usage(add_git(build_rows(hcom_json("agent", "list", "--all", "--json"),
                                                        hcom_json("list", "--json"))))
            except Exception as e:  # shown in the log, next refresh retries
                result = e
            self.after(0, self._apply, result)

        threading.Thread(target=work, daemon=True).start()

    def _apply(self, result):
        self.refreshing = False
        if isinstance(result, Exception):
            if str(result) != self.last_error:
                self.write_log(f"ERROR: {result}")
            self.last_error = str(result)
        else:
            self.last_error = None
            self.rows = {f"{r['agent']}|{r['instance']}": r for r in result}
            groups = (running_groups(result), running_tools(result))
            if groups != self.groups:
                self.groups = groups
                self.group_menu.delete(0, tk.END)
                for g, names in groups[0].items():
                    self.group_menu.add_command(label=f"@{g} ({len(names)})",
                                                command=lambda g=g, names=names: self.kill_group(f"@{g}", names))
                if groups[0] and groups[1]:
                    self.group_menu.add_separator()
                for t, names in groups[1].items():
                    self.group_menu.add_command(label=f"tool:{t} ({len(names)})",
                                                command=lambda t=t, names=names: self.kill_group(f"tool:{t}", names))
            self.render()
        if self.refresh_again:
            self.refresh_again = False
            self.refresh()
        else:
            self.timer = self.after(self.refresh_ms, self.refresh)

    def sort_by(self, col):
        """Clicks on one heading cycle ascending, descending, default order."""
        if self.sort_col != col:
            self.sort_col, self.sort_reverse = col, False
        elif not self.sort_reverse:
            self.sort_reverse = True
        else:
            self.sort_col = None
            self.sort_reverse = False
        self.render()

    def render(self):
        for col, title, _ in self.columns:
            arrow = (" ▼" if self.sort_reverse else " ▲") if col == self.sort_col else ""
            self.tree.heading(col, text=title + arrow)
        if self.sort_col:
            def key(r):
                v = r[self.sort_col]
                return (0, v, "") if isinstance(v, int) else (1, 0, str(v).lower())
        else:
            def key(r):
                return (not r["agent"], (r["agent"] or r["instance"]).lower(), not r["instance"], r["instance"])
        needle = self.filter_text.get().strip().lower()
        sel = self.tree.selection()
        self.tree.delete(*self.tree.get_children())
        for iid, r in sorted(self.rows.items(), key=lambda kv: key(kv[1]), reverse=self.sort_reverse):
            if self.running_only.get() and not r["instance"]:
                continue
            if self.blocked_only.get() and r["state"] != "blocked":
                continue
            if needle and needle not in " ".join([r["agent"], r["instance"], r["dir"], tilde(r["dir"]),
                                                  *r["groups"]]).lower():
                continue
            # A catalog row has a status only while the agent runs under other names.
            tag = r["state"] if r["state"] in ("active", "blocked", "error") else (
                "" if r["instance"] or r["status"] else "stopped")
            values = [cell(c, r) for c, _, _ in self.columns]
            self.tree.insert("", tk.END, iid=iid, values=values, tags=(tag,))
        if self.select_next and self.tree.exists(self.select_next):  # started with --as
            sel, self.select_next = [self.select_next], None
        if sel and not self.tree.exists(sel[0]):  # start/kill changes the id: keep the agent
            agent = sel[0].split("|")[0]
            sel = [i for i in self.tree.get_children() if agent and self.rows[i]["agent"] == agent][:1]
        if sel and self.tree.exists(sel[0]):
            self.tree.selection_set(sel[0])
            self.tree.focus(sel[0])
        self.update_buttons()

    # ── Actions ────────────────────────────────────────────────────────

    def run_default(self):
        row = self.selected()
        want = "running" if row and row["instance"] else "stopped"
        for b in self.buttons:
            if b != "---" and b.get("default") == want and enabled(b, row):
                self.run_button(b)
                return

    def run_button(self, b):
        row = self.selected()
        if (self.busy and not b.get("detach")) or not enabled(b, row):  # detach runs beside a command
            return
        if b["when"] == "always":
            if b.get("confirm") and not messagebox.askyesno(b["label"], f"{' '.join(b['cmd'])}?", parent=self):
                return
            self.run_command(b["cmd"], os.path.expanduser(b.get("cwd", HOME)))
            return
        template = b["cmds"].get(row["terminal"], DEFAULT_ATTACH) if "cmds" in b else b["cmd"]
        values = {
            **row["launch_context"],
            "agent": row["agent"],
            "instance": row["instance"],
            "dir": os.path.expanduser(row["dir"]),
            "terminal": row["terminal"],
        }
        asks = [t[5:-1] for t in template if t.startswith("{ask:") and t.endswith("}")]
        if asks:
            prefill = {"dir": values["dir"], "cli": row["catalog_cli"]}
            answers = self.ask(b["label"], asks, row["instance"] if b["when"] == "running" else row["agent"], prefill)
            if answers is None:
                return
            values.update({f"ask:{k}": "" if v == prefill.get(k) else v for k, v in answers.items()})
            required = [t for prev, t in zip(template, template[1:]) if prev == "--" and t.startswith("{ask:")]
            if empty := [t[5:-1] for t in required if not values.get(t[1:-1])]:
                self.write_log(f"{b['label']}: empty {', '.join(empty)}, nothing run")
                return
            if values.get("ask:resume"):
                values["ask:resume"] = "--continue" if values.get("ask:cli") else "--resume"
        cmd = []
        for token in template:
            if token.startswith("{ask:"):
                if values.get(token[1:-1]):
                    cmd.append(values[token[1:-1]])
                elif cmd and cmd[-1].startswith("--"):
                    cmd.pop()
                continue
            try:
                cmd.append(token.format_map(values))
            except (KeyError, ValueError) as e:  # a placeholder this instance lacks, or bad braces
                self.write_log(f"ERROR: {b['label']}: {token}: {e!r}, nothing run")
                return
        target = row["instance"] or row["agent"]
        if b.get("confirm") and not messagebox.askyesno(b["label"], f"{b['label']} {target}?", parent=self):
            return
        if b.get("detach"):
            cwd = b["cwd"].format_map(values) if b.get("cwd") else row["cwd"]
            self.write_log(f"$ {' '.join(cmd)}  (in {tilde(cwd)})")
            # stderr goes to an unlinked file, not a pipe: a program outliving the GUI must not
            # get SIGPIPE.
            err = None
            try:
                err = tempfile.TemporaryFile()
                proc = subprocess.Popen(cmd, cwd=cwd, env={**HCOM_ENV, "PWD": cwd}, start_new_session=True,
                                        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=err)
            except OSError as e:
                if err:
                    err.close()
                self.write_log(f"ERROR: {e}")
            else:
                threading.Thread(target=self._watch_detached, args=(b["label"], proc, err), daemon=True).start()
            self.refresh()
            return
        select = f"{row['agent']}|{values['ask:name']}" if values.get("ask:name") else None
        if asks:  # a Start replaces the pending selection of an earlier one
            self.select_next = select
        self.run_command(cmd, row["cwd"], select)

    def _watch_detached(self, label, proc, err):
        """Log the exit code and stderr of a detached program that fails right after start."""
        with err:
            try:
                code = proc.wait(timeout=DETACH_WATCH_SECONDS)
            except subprocess.TimeoutExpired:
                return
            if code:
                err.seek(0)
                self.after(0, self.write_log, f"{label}: {err.read().decode(errors='replace')}[exit {code}]")

    def kill_group(self, group, names):
        """Kill the running instances listed in the menu, by name: exactly what was confirmed,
        independent of which catalogs are reachable from the GUI's cwd."""
        if self.busy or not messagebox.askyesno("Kill group", f"Kill {group}: {', '.join(names)}?", parent=self):
            return
        self.run_command(["hcom", "kill", *names], HOME)

    def run_command(self, cmd, cwd, select=None):
        """select: the pending row id this command creates; dropped if the command fails."""
        self.busy = True
        self.update_buttons()
        self.config(cursor="watch")
        self.write_log(f"$ {' '.join(cmd)}")

        def work():
            try:
                out = subprocess.run(cmd, cwd=cwd, env=HCOM_ENV, capture_output=True, text=True, timeout=120)
                text, ok = f"{out.stdout}{out.stderr}[exit {out.returncode}]", out.returncode == 0
            except Exception as e:
                text, ok = f"ERROR: {e}", False
            self.after(0, self._command_done, text, ok, select)

        threading.Thread(target=work, daemon=True).start()

    def _command_done(self, text, ok, select):
        if not ok and select and self.select_next == select:
            self.select_next = None
        self.write_log(text)
        self.busy = False
        self.config(cursor="")
        self.update_buttons()
        self.refresh()

    def ask(self, title, keys, agent, prefill):
        """One entry per {ask:X}, prefilled from prefill; "dir" is browsable, "cli" a
        choice of installed CLIs, "resume" a checkbox ("1" when checked), "prompt" and "message"
        multi-line (Shift+Enter: newline, Enter: OK). None on cancel."""
        dlg = tk.Toplevel(self)
        dlg.title(f"{title} {agent}")
        dlg.transient(self)
        entries, result = {}, {}
        for n, k in enumerate(keys):
            ttk.Label(dlg, text=k).grid(row=n, column=0, sticky=tk.W, padx=5, pady=5)
            var = tk.StringVar(value=prefill.get(k, ""))
            if k == "resume":
                ttk.Checkbutton(dlg, variable=var, onvalue="1", offvalue="").grid(
                    row=n, column=1, sticky=tk.W, padx=5, pady=5)
            elif k == "cli":
                choices = [c for c, exe in CLI_BINARIES.items() if c == var.get() or shutil.which(exe)]
                ttk.Combobox(dlg, textvariable=var, values=choices, state="readonly", width=48).grid(
                    row=n, column=1, sticky=tk.EW, padx=5, pady=5)
            elif k in ("prompt", "message"):
                text = tk.Text(dlg, width=50, height=6, wrap=tk.WORD)
                text.grid(row=n, column=1, sticky=tk.EW, padx=5, pady=5)
                text.bind("<Shift-Return>", lambda e, t=text: t.insert(tk.INSERT, "\n") or "break")
                text.bind("<Return>", lambda e: ok() or "break")
                text.bind("<KP_Enter>", lambda e: ok() or "break")
                entries[k] = lambda t=text: t.get("1.0", "end-1c")
                continue
            else:
                ttk.Entry(dlg, textvariable=var, width=50).grid(row=n, column=1, sticky=tk.EW, padx=5, pady=5)
            if k == "dir":
                def browse(var=var):
                    path = filedialog.askdirectory(parent=dlg, initialdir=var.get() or HOME)
                    if path:
                        var.set(path)
                ttk.Button(dlg, text="Browse…", command=browse).grid(row=n, column=2, padx=5, pady=5)
            entries[k] = var.get

        def ok(_event=None):
            result.update({k: get().strip() for k, get in entries.items()})
            dlg.destroy()

        buttons = ttk.Frame(dlg)
        buttons.grid(row=len(keys), column=0, columnspan=3, sticky=tk.E, padx=5, pady=5)
        ttk.Button(buttons, text="OK", command=ok).pack(side=tk.LEFT, padx=2)
        ttk.Button(buttons, text="Cancel", command=dlg.destroy).pack(side=tk.LEFT, padx=2)
        dlg.bind("<Return>", ok)
        dlg.bind("<KP_Enter>", ok)
        dlg.bind("<Escape>", lambda e: dlg.destroy())
        dlg.grid_columnconfigure(1, weight=1)
        dlg.wait_visibility()
        dlg.grab_set()
        dlg.wait_window()
        return result or None

    def choose_columns(self):
        """Visible columns and their order: Space or double-click toggles, Up/Down (Ctrl+Up/Down)
        move, Reset returns to the gui.json/default set. At least one column stays visible."""
        titles = {k: t for k, t, _ in COLUMNS}
        shown = list(self.tree["columns"])
        items = [[k, True] for k in shown] + [[k, False] for k, _, _ in COLUMNS if k not in shown]
        dlg = tk.Toplevel(self)
        dlg.title("Columns")
        dlg.transient(self)
        lb = tk.Listbox(dlg, height=len(items), width=24, exportselection=False, activestyle="none")
        lb.grid(row=0, column=0, rowspan=5, sticky=tk.NSEW, padx=5, pady=5)

        def show(i):
            lb.delete(0, tk.END)
            for k, on in items:
                lb.insert(tk.END, f"{'☑' if on else '☐'} {titles[k]}")
            lb.selection_set(i)
            lb.activate(i)
            lb.see(i)

        def current():
            return (lb.curselection() or (0,))[0]

        def toggle(_event=None):
            i = current()
            items[i][1] = not items[i][1]
            show(i)
            return "break"

        def move(step):
            i = current()
            if 0 <= i + step < len(items):
                items[i], items[i + step] = items[i + step], items[i]
                show(i + step)
            return "break"

        def ok(_event=None):
            keys = [k for k, on in items if on]
            if not keys:
                dlg.bell()
                return
            dlg.destroy()
            self.set_columns(keys)

        def reset():
            dlg.destroy()
            self.set_columns(None)

        for n, (text, command) in enumerate((("Up", lambda: move(-1)), ("Down", lambda: move(1)),
                                             ("Reset", reset))):
            ttk.Button(dlg, text=text, command=command).grid(row=n, column=1, sticky=tk.EW, padx=5, pady=2)
        buttons = ttk.Frame(dlg)
        buttons.grid(row=5, column=0, columnspan=2, sticky=tk.E, padx=5, pady=5)
        ttk.Button(buttons, text="OK", command=ok).pack(side=tk.LEFT, padx=2)
        ttk.Button(buttons, text="Cancel", command=dlg.destroy).pack(side=tk.LEFT, padx=2)
        lb.bind("<space>", toggle)
        lb.bind("<Double-1>", toggle)
        lb.bind("<Control-Up>", lambda e: move(-1))
        lb.bind("<Control-Down>", lambda e: move(1))
        dlg.bind("<Return>", ok)
        dlg.bind("<KP_Enter>", ok)
        dlg.bind("<Escape>", lambda e: dlg.destroy())
        dlg.grid_rowconfigure(4, weight=1)
        show(0)
        lb.focus_set()
        dlg.wait_visibility()
        dlg.grab_set()
        dlg.wait_window()

    # ── Config and window state ────────────────────────────────────────

    def _load_json(self, path):
        try:
            with open(path) as f:
                return json.load(f)
        except FileNotFoundError:
            return {}
        except (OSError, ValueError) as e:
            self.after(0, self.write_log, f"ERROR: {path}: {e}")
            return {}

    def _restore_state(self):
        state = self._load_json(STATE_FILE)
        self.geometry(state.get("geometry", "1200x700"))
        self.running_only.set(state.get("running_only", False))
        self.blocked_only.set(state.get("blocked_only", False))
        if state.get("sort_col") in self.tree["columns"]:
            self.sort_col, self.sort_reverse = state["sort_col"], bool(state.get("sort_reverse"))

        def layout():
            if "sash_pos" in state:
                self.paned.sashpos(0, state["sash_pos"])
            for col, width in state.get("column_widths", {}).items():
                if col in self.tree["columns"]:
                    self.tree.column(col, width=width)

        self.after(100, layout)

    def _on_close(self):
        self._save_state()
        self.destroy()

    def _save_state(self):
        state = {
            "geometry": self.geometry(),
            "sash_pos": self.paned.sashpos(0),
            "running_only": self.running_only.get(),
            "blocked_only": self.blocked_only.get(),
            "sort_col": self.sort_col,
            "sort_reverse": self.sort_reverse,
            "column_widths": {c: self.tree.column(c, "width") for c in self.tree["columns"]},
        }
        if self.state_columns:
            state["columns"] = self.state_columns
        try:
            with open(STATE_FILE, "w") as f:
                json.dump(state, f)
        except OSError:
            pass


