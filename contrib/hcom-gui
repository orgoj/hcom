        # Chosen in the Columns dialog; overrides gui.json "columns".
        state = self._load_json(STATE_FILE)
        self.state_columns = with_new_columns(pick_columns(state.get("columns"))[0], state.get("columns_known"))
        self.columns = column_specs(self.state_columns or self.config_columns)
        self.status_names = None  # configured status columns, known after the first refresh
        # Saved widths and sort of status columns wait for that refresh too.
        self.saved_widths = state.get("column_widths") if isinstance(state.get("column_widths"), dict) else {}
        self.saved_sort = (state.get("sort_col"), bool(state.get("sort_reverse")))
        # Report tab keys (like "columns"); None shows every column.
        report = config.get("report")
        self.report = None
        if report is not None and not (isinstance(report, list) and all(isinstance(k, str) for k in report)):
            self.after(0, self.write_log, f"ERROR: {CONFIG_FILE}: report: not a list of column keys")
        elif report is not None:
            self.report, unknown = pick_columns(report)
            if unknown:
                self.after(0, self.write_log, f"ERROR: {CONFIG_FILE}: report: unknown columns: {', '.join(unknown)}")

        self.rows = {}
        self.groups = ({}, {})  # running_groups, running_tools
        self.sort_col, self.sort_reverse = None, False
        self.busy = self.refreshing = self.refresh_again = False
        self.timer = None
        self.events, self.events_at = None, None  # cached (life, messages) for the usage columns
        self.last_error = None
