    def later(self, seconds):
        """Let seconds pass for the shown rows: real ages grow with the clock, age 0 stays 0."""
        self.offset = getattr(self, "offset", 0) + seconds
        for r in self.app.rows.values():
            if r["instance"] and r["since"] > 0:
