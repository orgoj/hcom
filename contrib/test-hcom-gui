def fake_hcom_json(*args):
    return CATALOG if args[:2] == ("agent", "list") else LIVE


class SyncThreading:
    """Runs a "thread" at once: Tk's after() from a real thread needs a running mainloop."""

    class Thread:
        def __init__(self, target, args=(), daemon=None):
            self.target, self.args = target, args

        def start(self):
            self.target(*self.args)


class RunningGroups(unittest.TestCase):
    def test_groups_hold_only_running_instances(self):
        rows = gui.build_rows(CATALOG, LIVE)
        self.assertEqual(gui.running_groups(rows), {"persistent": ["a1", "a2x"], "wdt_all": ["a2x"]})

    def test_roaming_column_marks_roaming_agent_and_its_instances(self):
        catalog = CATALOG + [{"name": "r1", "cli": "claude", "roaming": True, "source": "global"}]
        live = LIVE + [{"name": "r1_proj_123", "tool": "claude", "status": "listening",
                        "launch_context": {"agent_name": "r1"}}]
        rows = {(r["agent"], r["instance"]): r for r in gui.build_rows(catalog, live)}
        self.assertEqual(rows[("r1", "r1_proj_123")]["roaming"], "↻")
        self.assertEqual(rows[("r1", "")]["roaming"], "↻")
        self.assertEqual(rows[("a1", "a1")]["roaming"], "")
        self.assertEqual(rows[("a3", "")]["roaming"], "")

    def test_one_running_roaming_instance_keeps_its_catalog_row(self):
        catalog = CATALOG + [{"name": "r1", "cli": "claude", "roaming": True, "source": "global"}]
        for instance in ("r1_proj_123", "r1"):  # also when an instance holds the catalog name
            live = LIVE + [{"name": instance, "tool": "claude", "status": "listening",
                            "launch_context": {"agent_name": "r1"}}]
            r1 = [r for r in gui.build_rows(catalog, live) if r["agent"] == "r1"]
            self.assertEqual(sorted(r["instance"] for r in r1), sorted(["", instance]))
            self.assertEqual(next(r for r in r1 if not r["instance"])["status"], f"running as {instance}")

    def test_tools_hold_only_running_instances(self):
        rows = gui.build_rows(CATALOG, LIVE)
        self.assertEqual(gui.running_tools(rows), {"claude": ["a1", "solo"], "codex": ["a2x"]})

    def test_always_buttons_need_no_row(self):
        self.assertTrue(gui.enabled({"when": "always"}, None))
        self.assertFalse(gui.enabled({"when": "running"}, None))


class GitState(unittest.TestCase):
    def setUp(self):
        os.makedirs(os.path.join(REPO, "tmp"), exist_ok=True)
        self.dir = tempfile.TemporaryDirectory(dir=os.path.join(REPO, "tmp"))
        self.addCleanup(self.dir.cleanup)

    def git(self, *args):
        subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@t", "-c", "commit.gpgsign=false",
                        "-c", "init.defaultBranch=main", *args], check=True, capture_output=True)

    def path(self, name):
        return os.path.join(self.dir.name, name)

    def test_clean_repo_without_upstream_shows_only_branch(self):
        self.git("init", self.path("r"))
        self.git("-C", self.path("r"), "commit", "--allow-empty", "-m", "c1")
        self.assertEqual(gui.git_state(self.path("r")), ("main", ""))

    def test_dirty_ahead_and_behind_upstream(self):
        self.git("init", self.path("up"))
        self.git("-C", self.path("up"), "commit", "--allow-empty", "-m", "c1")
        self.git("clone", self.path("up"), self.path("r"))
        self.git("-C", self.path("up"), "commit", "--allow-empty", "-m", "c2")
        self.git("-C", self.path("r"), "fetch")
        self.git("-C", self.path("r"), "commit", "--allow-empty", "-m", "local")
        self.git("-C", self.path("r"), "commit", "--allow-empty", "-m", "local2")
        open(self.path("r/new.txt"), "w").close()
        self.assertEqual(gui.git_state(self.path("r")), ("main", "* ↑2 ↓1"))

    def test_outside_repo_or_missing_dir_is_empty(self):
        # GIT_CEILING_DIRECTORIES: the temp dir lives inside this repo's tmp/.
        os.environ["GIT_CEILING_DIRECTORIES"] = self.dir.name
        self.addCleanup(os.environ.pop, "GIT_CEILING_DIRECTORIES")
        os.mkdir(self.path("plain"))
        self.assertEqual(gui.git_state(self.path("plain")), ("", ""))
        self.assertEqual(gui.git_state(self.path("missing")), ("", ""))

    def test_add_git_queries_each_dir_once(self):
        calls = []
        old = gui.git_state
        gui.git_state = lambda d: calls.append(d) or ("main", "*")
        self.addCleanup(setattr, gui, "git_state", old)
        rows = gui.add_git([{"dir": "/w"}, {"dir": "/w"}, {"dir": ""}])
        self.assertEqual(calls, ["/w"])
        self.assertEqual([(r["branch"], r["git"]) for r in rows], [("main", "*"), ("main", "*"), ("", "")])


def claude_line(tokens, **extra):
    usage = {"input_tokens": 2, "cache_creation_input_tokens": 8, "cache_read_input_tokens": tokens - 10}
    return {"type": "assistant", "message": {"model": "m", "usage": usage}, **extra}


def codex_line(info, used_percent=None):
    payload = {"type": "token_count", "info": info}
    if used_percent is not None:
        payload["rate_limits"] = {"primary": {"used_percent": used_percent, "window_minutes": 300}}
    return {"type": "event_msg", "payload": payload}


class ContextUsage(unittest.TestCase):
    def setUp(self):
        os.makedirs(os.path.join(REPO, "tmp"), exist_ok=True)
        self.dir = tempfile.TemporaryDirectory(dir=os.path.join(REPO, "tmp"))
        self.addCleanup(self.dir.cleanup)

    def transcript(self, name, entries):
        path = os.path.join(self.dir.name, name)
        with open(path, "w") as f:
            f.writelines(gui.json.dumps(e) + "\n" for e in entries)
        return path

    def test_claude_latest_main_assistant_usage(self):
        path = self.transcript("c.jsonl", [
            claude_line(50_000), claude_line(80_000),
            claude_line(5_000, isSidechain=True), {"type": "user", "message": {"content": "x"}},
        ])
        self.assertEqual(gui.transcript_usage("claude", path), {"context": (80_000, gui.CLAUDE_CONTEXT_WINDOW)})

    def test_codex_latest_context_and_quota(self):
        last = {"last_token_usage": {"input_tokens": 125_000}, "model_context_window": 258_400}
        path = self.transcript("x.jsonl", [
            codex_line({"last_token_usage": {"input_tokens": 9}, "model_context_window": 258_400}, 10.0),
            codex_line(last), codex_line(None, 49.0),
        ])
        self.assertEqual(gui.transcript_usage("codex", path), {"context": (125_000, 258_400), "quota": 49.0})

    def test_codex_without_rate_limits_has_no_quota(self):
        info = {"last_token_usage": {"input_tokens": 5_000}, "model_context_window": 258_400}
        path = self.transcript("x.jsonl", [codex_line(info)])
        self.assertEqual(gui.transcript_usage("codex", path), {"context": (5_000, 258_400)})

    def test_tail_skips_cut_first_line(self):
        path = self.transcript("c.jsonl", [claude_line(1_000), {"type": "user", "pad": "x" * 500}])
        old = gui.TRANSCRIPT_TAIL_BYTES
        gui.TRANSCRIPT_TAIL_BYTES = os.path.getsize(path) - 20  # cuts into the usage line
        self.addCleanup(setattr, gui, "TRANSCRIPT_TAIL_BYTES", old)
        self.assertEqual(gui.transcript_usage("claude", path), {})

    def test_unknown_cli_missing_file_or_no_usage_is_none(self):
        path = self.transcript("c.jsonl", [{"type": "user", "message": {"content": "x"}}])
        self.assertEqual(gui.transcript_usage("claude", path), {})
        self.assertEqual(gui.transcript_usage("gemini", self.transcript("g.jsonl", [claude_line(1_000)])), {})
        self.assertEqual(gui.transcript_usage("claude", os.path.join(self.dir.name, "missing.jsonl")), {})


class Stats(unittest.TestCase):
    NOW = gui.ts_epoch("2026-10-02T10:10:00")

    def test_counts_runtime_handoffs_messages_stops_and_failures(self):
        stats = gui.event_stats(LIFE, MESSAGES, {"a1"}, self.NOW)
        a1, a3 = stats["a1"], stats["a3"]
        self.assertEqual((a1["starts"], a1["runtime"], a1["handoffs"]), (2, 100 + 600, 1))
        self.assertEqual((a1["sent"], a1["received"], a1["msgs"]), (1, 1, 2))
        self.assertEqual(a1["last_start"], gui.ts_epoch("2026-10-02T10:00:00"))
        self.assertEqual((a1["stops"], a1["stop_kinds"], a1["failed"]), (1, [1, 0, 0], 0))
        # a3 is not running: its open session adds nothing.
        self.assertEqual((a3["starts"], a3["runtime"], a3["handoffs"]), (2, 30, 0))
        self.assertEqual((a3["stops"], a3["stop_kinds"], a3["failed"]), (2, [0, 1, 1], 2))
        self.assertEqual((a3["sent"], a3["received"]), (0, 1))
        self.assertEqual((stats["a2x"]["sent"], stats["a2x"]["received"]), (0, 1))

    def test_rows_without_events_stay_empty(self):
        rows = gui.add_stats([{"agent": "", "instance": "nobody"}], (LIFE, MESSAGES))
        self.assertEqual([rows[0][c] for c in gui.STATS], [""] * len(gui.STATS))
        rows = gui.add_stats([{"agent": "a3", "instance": ""}], None)
        self.assertEqual(rows[0]["starts"], "")


class App(unittest.TestCase):
    def setUp(self):
        os.makedirs(os.path.join(REPO, "tmp"), exist_ok=True)
        self.dir = tempfile.TemporaryDirectory(dir=os.path.join(REPO, "tmp"))
        config = os.path.join(self.dir.name, "gui.json")
        with open(config, "w") as f:
            f.write(gui.json.dumps({"commands": COMMANDS}))
        self.patch("CONFIG_FILE", config)
        self.patch("STATE_FILE", os.path.join(self.dir.name, "gui-state.json"))
        self.patch("hcom_json", fake_hcom_json)
        self.patch("load_events", lambda: (LIFE, MESSAGES))
        self.patch("git_state", lambda d: ("main", "* ↑1") if d == "/w" else ("", ""))
        self.patch("transcript_usage", lambda tool, path: {"context": (62000, 1_000_000), "quota": 48.6}
                   if path == "/t/a1.jsonl" else {})
        self.patch("threading", SyncThreading)
        self.idle_runs, self.idle_answer = [], {}

        def fake_idle_check(names):  # idle_answer: {name: class} or an error text
            self.idle_runs.append(list(names))
            if isinstance(self.idle_answer, str):
                return self.idle_answer
            return {n: {"class": c, "text_sha1": f"sha-{n}" if c else None, "corrected": False}
                    for n, c in self.idle_answer.items()}

        self.patch("idle_check", fake_idle_check)
        self.labels, self.label_error = [], None

        def fake_idle_label(sha, cls):
            self.labels.append((sha, cls))
            return self.label_error

        self.patch("idle_label", fake_idle_label)
        self.asked, self.answer = [], True

        def askyesno(title, text, **_):
            self.asked.append((title, text))
            return self.answer

        self.patch("messagebox", type("Ask", (), {"askyesno": staticmethod(askyesno)}))
        self.app = gui.App()
        self.ran = []
        self.app.run_command = lambda cmd, cwd, select=None: self.ran.append((cmd, cwd))
        self.app.update()
        self.assertTrue(self.app.rows, "first refresh did not finish")

    def tearDown(self):
        for job in self.app.tk.splitlist(self.app.tk.call("after", "info")):
            self.app.after_cancel(job)
        self.app.destroy()
        self.dir.cleanup()

    def patch(self, name, value):
        old = getattr(gui, name)
        setattr(gui, name, value)
        self.addCleanup(setattr, gui, name, old)

