    def test_text_filter_matches_agent_instance_dir_and_groups(self):
        everything = self.shown()
        self.app.filter_entry.insert("end", "WDT")  # the table narrows at once
        self.assertEqual(sorted(self.shown()), ["a2|", "a2|a2x", "a3|"])
        for text, rows in (("A2X", ["a2|a2x"]), ("sol", ["|solo"]), ("/w", ["a1|a1", "a2|", "a2|a2x", "a3|"])):
            self.app.filter_text.set(text)
            self.assertEqual(sorted(self.shown()), rows, text)
        self.app.rows["|solo"]["dir"] = os.path.join(gui.HOME, "proj")
        self.app.filter_text.set("~/PROJ")  # matches the shown ~ form too
        self.assertEqual(self.shown(), ["|solo"])
        self.app.filter_text.set("")
        self.assertEqual(self.shown(), everything)

