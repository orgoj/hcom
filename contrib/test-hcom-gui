class IdleCheck(unittest.TestCase):
    """gui.idle_check against small stand-in scripts for idle_check.py."""

    def script(self, body):
        os.makedirs(os.path.join(REPO, "tmp"), exist_ok=True)
        d = tempfile.TemporaryDirectory(dir=os.path.join(REPO, "tmp"))
        self.addCleanup(d.cleanup)
        path = os.path.join(d.name, "idle_check.py")
        with open(path, "w") as f:
            f.write("import json, subprocess, sys, time\nnames = sys.argv[3:]\n" + body)  # after --json --
        old = gui.IDLE_CHECK
        gui.IDLE_CHECK = path
        self.addCleanup(setattr, gui, "IDLE_CHECK", old)
        return d.name

    def test_classes_by_name(self):
        self.script('print(json.dumps([{"name": n, "class": "waiting" if n == "a" else None, "text_sha1": "s" + n,'
                    ' "corrected": n == "a"} for n in names]))')
        self.assertEqual(gui.idle_check(["a", "b"]), {"a": {"class": "waiting", "text_sha1": "sa", "corrected": True},
                                                      "b": {"class": None, "text_sha1": "sb", "corrected": False}})

    def test_label(self):
        d = self.script('open(sys.argv[0] + ".args", "w").write(json.dumps(sys.argv[1:]))')
        self.assertIsNone(gui.idle_label("abc", "done"))
        with open(os.path.join(d, "idle_check.py.args")) as f:
            self.assertEqual(gui.json.load(f), ["--label", "abc", "done"])
        self.script('print("secret", file=sys.stderr)\nprint("idle_check: live data write failed", file=sys.stderr)\n'
                    'sys.exit(1)')
        self.assertEqual(gui.idle_label("abc", "done"), "idle label: live data write failed")

    def test_failure_reports_only_the_category_line(self):
        self.script('print("secret text", file=sys.stderr)\nprint("idle_check: score failed (exit 1)", '
                    'file=sys.stderr)\nsys.exit(1)')
        self.assertEqual(gui.idle_check(["a"]), "idle: score failed (exit 1)")
        self.script('print("secret text", file=sys.stderr)\nsys.exit(2)')
        self.assertEqual(gui.idle_check(["a"]), "idle: exit 2")
        self.script('print("secret text")')
        self.assertEqual(gui.idle_check(["a"]), "idle: output invalid")

    def test_timeout_kills_the_process_group(self):
        d = self.script('p = subprocess.Popen(["sleep", "30"])\nopen(names[0], "w").write(str(p.pid))\n'
                        'time.sleep(30)')
        old = gui.IDLE_TIMEOUT_SECONDS
        gui.IDLE_TIMEOUT_SECONDS = 1
        self.addCleanup(setattr, gui, "IDLE_TIMEOUT_SECONDS", old)
        pidfile = os.path.join(d, "child.pid")
        self.assertEqual(gui.idle_check([pidfile]), "idle: timeout after 1 s")
        with open(pidfile) as f:
            child = f.read()
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:  # killed: gone, or a zombie until init reaps it
            try:
                with open(f"/proc/{child}/stat") as f:
                    if f.read().split(") ")[1][0] == "Z":
                        break
            except FileNotFoundError:
                break
            time.sleep(0.05)
        else:
            self.fail("scorer stand-in still runs")

    def test_launch_failure(self):
        old = gui.sys
        gui.sys = type("Sys", (), {"executable": "/nonexistent/python3"})
        self.addCleanup(setattr, gui, "sys", old)
        self.assertEqual(gui.idle_check(["a"]), "idle: No such file or directory")


