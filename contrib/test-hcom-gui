        self.app.tree.focus_force()
        self.app.update()

    def fake_popen(self):
        opened = []
        real = gui.subprocess

        def popen(cmd, **kw):
            opened.append((cmd, kw["cwd"]))
            return real.Popen(["true"])

        self.patch("subprocess", type("Sub", (), {"Popen": popen, "DEVNULL": None,
                                                  "TimeoutExpired": real.TimeoutExpired}))
        return opened

    def test_open_with_key_opens_selected_dir(self):
        self.open_with(["zed", "{dir}"])
        opened = self.fake_popen()
        self.app.tree.event_generate("<KeyPress-z>", when="now")
        self.assertEqual(opened, [(["zed", "/w"], self.app.rows["a1|a1"]["cwd"])])

