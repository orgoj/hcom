    def type_prompt(self, enter, key="prompt"):
        def type_prompt():
            dlg = next(w for w in self.app.winfo_children() if isinstance(w, gui.tk.Toplevel))
            text = next(w for w in dlg.winfo_children() if isinstance(w, gui.tk.Text))
            text.focus_force()
            text.update()
            text.insert("end", "line 1")
            text.event_generate("<Shift-Return>", when="now")
            text.insert("end", "line 2")
            text.event_generate(enter, when="now")

        self.app.after(200, type_prompt)
        return self.app.ask("Start", ["name", "prompt"] if key == "prompt" else [key], "a3", {})

    def test_keypad_enter_confirms_dialog(self):
        def press():
            dlg = next(w for w in self.app.winfo_children() if isinstance(w, gui.tk.Toplevel))
            entry = next(w for w in dlg.winfo_children() if isinstance(w, gui.ttk.Entry))
            entry.focus_force()
            entry.update()
            entry.event_generate("<KP_Enter>", when="now")

        self.app.after(200, press)
