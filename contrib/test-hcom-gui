def life(eid, instance, ts, action, **data):
    return {"id": eid, "instance": instance, "ts": ts, "type": "life", "data": {"action": action, **data}}


# a1 runs (its open session counts up to now); a3 only has a catalog row and is stopped.
LIFE = [
    life(1, "a1", "2026-10-01T10:00:00", "created"),
    life(2, "a1", "2026-10-01T10:01:40", "stopped", reason="killed", by="cli"),
    life(3, "a3", "2026-10-01T11:00:00", "created"),
    life(4, "a3", "2026-10-01T11:00:30", "stopped", reason="killed", by="idle_kill"),
    life(5, "a3", "2026-10-01T12:00:00", "launch_failed"),
    life(6, "a3", "2026-10-01T12:05:00", "launch_blocked"),
    life(7, "a1", "2026-10-02T09:00:00", "handoff", by="a1"),
    life(8, "a3", "2026-10-02T09:30:00", "stopped", reason="exit:prompt_input_exit"),
    life(9, "a1", "2026-10-02T10:00:00", "created"),
    life(10, "a3", "2026-10-02T11:00:00", "created"),
]
