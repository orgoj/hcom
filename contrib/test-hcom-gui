    def test_open_with_outliving_the_watch_keeps_writing_stderr(self):
        # A pipe closed after the watch would kill sh with SIGPIPE before it creates the marker.
        marker = os.path.join(self.dir.name, "marker")
        self.patch("DETACH_WATCH_SECONDS", 0.1)
        self.open_with(["sh", "-c", f"sleep 0.5; echo late >&2; touch {marker}; exit 3", "{dir}"])
        self.app.rows["a1|a1"]["cwd"] = gui.HOME
        self.app.tree.event_generate("<KeyPress-z>", when="now")
        for _ in range(50):
            if os.path.exists(marker):
                break
            time.sleep(0.1)
        self.app.update()
        self.assertTrue(os.path.exists(marker))
        self.assertNotIn("[exit", self.app.log.get("1.0", "end"))

